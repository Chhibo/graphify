# Bazaarly – Apache settings
Options -Indexes
DirectoryIndex index.php

<IfModule mod_php.c>
  php_value upload_max_filesize 16M
  php_value post_max_size 64M
</IfModule>

# Never serve configuration or internal files
<FilesMatch "^(config\.php|.*\.sqlite.*|.*\.md|\.git.*)$">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>Order allow,deny
  Deny from all</IfModule>
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
