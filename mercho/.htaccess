# Mercho
DirectoryIndex index.php
Options -Indexes

# Clean links (switch on in Admin > Settings > SEO), sitemap.xml and robots.txt
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^product/([A-Za-z0-9\-_]+)/?$ product.php?slug=$1 [L,QSA]
  RewriteRule ^category/([A-Za-z0-9\-_]+)/?$ shop.php?cat=$1 [L,QSA]
  RewriteRule ^page/([A-Za-z0-9\-_]+)/?$ page.php?slug=$1 [L,QSA]
  RewriteRule ^blog/([A-Za-z0-9\-_]+)/?$ page.php?slug=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>

# Speed: compress text files and let browsers cache images, CSS and JS
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/gif "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# Block direct access to internal files
<FilesMatch "^(config\.php|.*\.sqlite|.*\.lock|README\.md)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
