# WanderLuxe Travel CMS
Options -Indexes
DirectoryIndex index.php

# Protect sensitive files
<FilesMatch "^(config\.php|.*\.sql|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
